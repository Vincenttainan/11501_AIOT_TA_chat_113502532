<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="20dp">
    <TextView android:id="@+id/serverRoomTitle" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="聊天室 Server" android:textSize="24sp" android:textStyle="bold" />
    <TextView android:id="@+id/serverStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:text="狀態：啟動中…" android:textSize="16sp" />
    <TextView android:id="@+id/serverAddress" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="本機 IP：取得中…　Port：5000" android:textSize="16sp" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="16dp" android:text="聊天室訊息" android:textStyle="bold" />
    <TextView android:id="@+id/serverMembers" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="4dp"
        android:text="在線成員（1）：Server" android:textSize="14sp" />
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:background="#F1F3F6" android:padding="12dp">
        <TextView android:id="@+id/serverMessages" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="等待 Client 連線…" android:textSize="16sp" />
    </ScrollView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <EditText android:id="@+id/serverMessageInput" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:hint="輸入訊息" android:inputType="text" />
        <Button android:id="@+id/serverSendButton" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="傳送" />
    </LinearLayout>
</LinearLayout>
