<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center" android:padding="24dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="多人聊天室 Server" android:textSize="26sp" android:textStyle="bold" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="24dp" android:text="請輸入聊天室名稱" android:textSize="16sp" />
    <EditText android:id="@+id/serverNameInput" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:hint="例如：週五聊天室"
        android:inputType="textCapSentences" android:singleLine="true" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="20dp" android:text="請選擇聊天室模式" android:textSize="16sp" />
    <RadioGroup android:id="@+id/serverModeGroup" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:orientation="horizontal">
        <RadioButton android:id="@+id/textModeOption" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:checked="true" android:text="Text Mode" />
        <RadioButton android:id="@+id/paintModeOption" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="Paint Mode" />
    </RadioGroup>
    <Button android:id="@+id/startServerButton" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="啟動 Server" />
</LinearLayout>
